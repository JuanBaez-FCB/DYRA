<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Emulsionantes en Alimentos — FCB-UANL</title>
<style>
* { margin:0; padding:0; box-sizing:border-box; }
body { font-family:'Segoe UI',system-ui,sans-serif; color:#263238; background:#fff; }
.app { max-width:780px; margin:0 auto; padding:0 16px 32px; }
.header { text-align:center; padding:24px 0 16px; border-bottom:2px solid #1E3A5F; margin-bottom:20px; }
.header h1 { font-size:22px; font-weight:700; color:#1E3A5F; letter-spacing:-0.3px; }
.header p { margin-top:6px; font-size:13px; color:#78909C; }
.tabs { display:flex; border-bottom:2px solid #ECEFF1; margin-bottom:20px; overflow-x:auto; }
.tab { padding:10px 16px; border:none; border-bottom:3px solid transparent; background:none; cursor:pointer; font-size:13px; font-weight:400; color:#90A4AE; white-space:nowrap; transition:all .2s; font-family:inherit; }
.tab.active { border-bottom-color:#1E3A5F; font-weight:700; color:#1E3A5F; }
.selector { display:flex; gap:8px; margin-bottom:20px; flex-wrap:wrap; }
.sel-btn { padding:8px 18px; border:2px solid; border-radius:6px; cursor:pointer; font-size:13px; font-weight:600; transition:all .2s; font-family:inherit; background:#fff; }
.sel-btn.on { color:#fff; }
.content { min-height:300px; }
.split { display:flex; gap:24px; flex-wrap:wrap; }
.split-vis { flex:1 1 280px; min-width:280px; display:flex; justify-content:center; }
.split-info { flex:1 1 280px; min-width:260px; }
.split-info h2 { font-size:18px; font-weight:700; margin-bottom:8px; }
.split-info .sub { font-size:12px; color:#78909C; font-style:italic; margin-bottom:12px; }
.split-info .desc { font-size:13px; line-height:1.6; color:#37474F; margin-bottom:16px; }
.split-info h3 { font-size:13px; font-weight:700; color:#37474F; margin-bottom:6px; }
.app-list { list-style:none; padding-left:0; }
.app-list li { font-size:13px; padding:3px 0; color:#455A64; }
.app-list .dot { display:inline-block; width:6px; height:6px; border-radius:50%; margin-right:8px; }
.note-box { padding:12px 16px; border-left:4px solid; border-radius:0 6px 6px 0; font-size:13px; line-height:1.5; color:#37474F; margin-top:16px; }
.info-box { margin-top:20px; padding:12px 16px; background:#FAFAFA; border-radius:6px; border:1px solid #ECEFF1; font-size:13px; line-height:1.6; color:#455A64; }
.intro { font-size:13px; line-height:1.6; color:#455A64; margin-bottom:16px; max-width:600px; }
table { width:100%; border-collapse:collapse; font-size:13px; }
th { padding:10px 12px; text-align:center; font-size:13px; border-bottom:2px solid #37474F; }
td { padding:8px 12px; text-align:center; border-bottom:1px solid #ECEFF1; }
.compare-row { display:flex; gap:8px; justify-content:center; margin-top:24px; flex-wrap:wrap; }
.compare-card { text-align:center; flex:0 1 180px; padding:8px; border-radius:8px; border:1px solid #eee; transition:all .2s; }
.compare-card.on { }
.compare-card p { font-size:11px; font-weight:600; margin-top:4px; }
.footer { margin-top:32px; padding-top:12px; border-top:1px solid #ECEFF1; font-size:11px; color:#B0BEC5; text-align:center; }
/* Quiz */
.quiz-intro { font-size:13px; line-height:1.6; color:#455A64; margin-bottom:20px; max-width:640px; }
.quiz-question { padding:16px 18px; border:1px solid #ECEFF1; border-left:4px solid #1E3A5F; border-radius:6px; background:#FAFAFA; margin-bottom:14px; }
.quiz-question .q-text { font-size:14px; font-weight:600; color:#1E3A5F; margin-bottom:12px; line-height:1.5; }
.quiz-options { display:flex; flex-direction:column; gap:6px; }
.quiz-opt { text-align:left; padding:9px 12px; border:1.5px solid #CFD8DC; border-radius:5px; background:#fff; font-size:13px; color:#37474F; cursor:pointer; font-family:inherit; transition:all .15s; }
.quiz-opt:hover:not(.disabled) { border-color:#1E3A5F; background:#F5F7FA; }
.quiz-opt.correct { border-color:#2D7D46; background:#E8F5E9; color:#1B5E20; font-weight:600; }
.quiz-opt.incorrect { border-color:#C62828; background:#FFEBEE; color:#B71C1C; }
.quiz-opt.disabled { cursor:default; opacity:0.75; }
.quiz-feedback { display:none; margin-top:12px; padding:10px 14px; border-radius:5px; font-size:12.5px; line-height:1.5; }
.quiz-feedback.show { display:block; }
.quiz-feedback.ok { background:#E8F5E9; color:#1B5E20; border-left:3px solid #2D7D46; }
.quiz-feedback.bad { background:#FFF3E0; color:#5D4037; border-left:3px solid #C9A227; }
#scoreBar { margin-top:20px; padding:14px 18px; background:#1E3A5F; color:#F7F6F2; border-radius:6px; text-align:center; font-size:14px; }
#scoreBar strong { color:#C9A227; font-size:16px; }
.quiz-reset { display:inline-block; margin-top:14px; padding:8px 20px; background:#fff; border:2px solid #1E3A5F; color:#1E3A5F; border-radius:5px; cursor:pointer; font-size:13px; font-weight:600; font-family:inherit; }
.quiz-reset:hover { background:#1E3A5F; color:#fff; }
@media(max-width:500px){ .split{flex-direction:column;} .tab{padding:8px 10px;font-size:12px;} }
</style>
</head>
<body>

<div class="app" id="app"></div>

<script>
// ─── DATA ───
const EM = {
  monoglyceride: {
    key:'monoglyceride', name:'Monoglicérido', shortName:'MAG', hlb:'3.8', hlbNum:3.8, mw:'~356',
    description:'Éster de glicerol con un solo ácido graso. Es el emulsionante más utilizado en la industria alimentaria. Posee un grupo hidroxilo libre que actúa como cabeza polar y una cadena acilo como cola hidrofóbica.',
    applications:['Panificación (interacción con almidón)','Margarinas y spreads','Helados (control de cristalización de grasa)','Productos cárnicos'],
    emulsionType:'W/O', tails:1, headLabel:'Glicerol|(2 −OH libres)', headGroups:2, headGroupLabels:['OH','OH'],
    tailLabel:'Ácido graso (C16–C18)', interfaceNote:'Con una sola cola y cabeza polar grande, adopta forma de cono — favorece curvatura positiva. Su HLB bajo lo posiciona como estabilizador de emulsiones W/O.',
    color:'#2D7D46', light:'#E8F5E9', accent:'#66BB6A'
  },
  diglyceride: {
    key:'diglyceride', name:'Diglicérido', shortName:'DAG', hlb:'1.8', hlbNum:1.8, mw:'~594',
    description:'Éster de glicerol con dos ácidos grasos. Más lipofílico que el monoglicérido debido a la segunda cadena acilo. Puede existir como 1,2-DAG o 1,3-DAG según la posición de esterificación.',
    applications:['Co-emulsionante con MAG','Aceites funcionales (1,3-DAG)','Shortenings y grasas plásticas','Sustituto parcial de triglicéridos'],
    emulsionType:'W/O', tails:2, headLabel:'Glicerol|(1 −OH libre)', headGroups:1, headGroupLabels:['OH'],
    tailLabel:'2 Ácidos grasos', interfaceNote:'Con dos colas y una cabeza polar pequeña (un solo −OH libre), tiene forma de cono truncado invertido — favorece curvatura negativa y emulsiones W/O.',
    color:'#C56200', light:'#FFF3E0', accent:'#FFA726'
  },
  lecithin: {
    key:'lecithin', name:'Lecitina', shortName:'Fosfatidilcolina', hlb:'7–9', hlbNum:8, mw:'~758',
    description:'Fosfolípido compuesto por glicerol, dos ácidos grasos, un grupo fosfato y colina. Es un emulsionante natural presente en soya, huevo y girasol. Su doble cola y cabeza polar zwitteriónica le confieren excelente actividad interfacial.',
    applications:['Chocolate (viscosidad y fluidez)','Emulsiones O/W y W/O','Productos instantáneos (wettability)','Desmoldantes industriales'],
    emulsionType:'O/W y W/O', tails:2, headLabel:'Fosfato + Colina|(zwitteriónica)', headGroups:3, headGroupLabels:['P','N⁺','O⁻'],
    tailLabel:'2 Ácidos grasos (sn-1, sn-2)', interfaceNote:'Sus dos colas y cabeza polar zwitteriónica le dan forma cilíndrica, permitiendo empacar eficientemente en la interfaz. Puede estabilizar tanto O/W como W/O dependiendo de las condiciones.',
    color:'#1565C0', light:'#E3F2FD', accent:'#42A5F5'
  }
};
const KEYS = ['monoglyceride','diglyceride','lecithin'];
const TABS = [{id:'structure',label:'Estructura molecular'},{id:'interface',label:'Orientación en interfaz'},{id:'hlb',label:'Escala HLB'},{id:'compare',label:'Comparación'},{id:'quiz',label:'Cuestionario'}];
const HLB_ZONES = [{min:0,max:3,label:'Antiespumante',bg:'#FFEBEE'},{min:3,max:6,label:'Emulsión W/O',bg:'#FFF3E0'},{min:6,max:8,label:'Agente humectante',bg:'#FFFDE7'},{min:8,max:16,label:'Emulsión O/W',bg:'#E3F2FD'},{min:16,max:18,label:'Solubilizante',bg:'#E8F5E9'}];

let state = { tab:'structure', sel:'monoglyceride' };

function cur(){ return EM[state.sel]; }

// ─── SVG BUILDERS ───
function moleculeSVG(d, showInterface){
  const w=320, cx=w/2, headR=28;
  const h = showInterface ? 340 : 260;
  const headY = showInterface ? 160 : 80;
  const tailLen=110, tailSp=30;
  const tails = d.tails===1 ? [{x:cx,y:headY+headR}] : [{x:cx-tailSp/2,y:headY+headR},{x:cx+tailSp/2,y:headY+headR}];
  let svg = `<svg viewBox="0 0 ${w} ${h}" width="100%" style="max-width:320px" xmlns="http://www.w3.org/2000/svg">`;

  if(showInterface){
    svg += `<defs>
      <pattern id="wat-${d.shortName}" width="20" height="20" patternUnits="userSpaceOnUse"><rect width="20" height="20" fill="#BBDEFB"/><text x="3" y="14" font-size="10" fill="#90CAF9">~</text></pattern>
      <pattern id="oil-${d.shortName}" width="16" height="16" patternUnits="userSpaceOnUse"><rect width="16" height="16" fill="#FFF9C4"/><circle cx="8" cy="8" r="2" fill="#FFF176" opacity="0.5"/></pattern>
    </defs>`;
    svg += `<rect x="0" y="0" width="${w}" height="${headY-10}" fill="url(#wat-${d.shortName})"/>`;
    svg += `<text x="16" y="24" font-size="13" font-weight="600" fill="#1565C0" font-family="system-ui">Fase acuosa</text>`;
    svg += `<rect x="0" y="${headY+40}" width="${w}" height="${h-headY-40}" fill="url(#oil-${d.shortName})"/>`;
    svg += `<text x="16" y="${headY+62}" font-size="13" font-weight="600" fill="#F9A825" font-family="system-ui">Fase oleosa</text>`;
    svg += `<line x1="0" y1="${headY-10}" x2="${w}" y2="${headY-10}" stroke="#78909C" stroke-width="1" stroke-dasharray="6,3"/>`;
    svg += `<text x="${w-8}" y="${headY-16}" font-size="10" fill="#78909C" text-anchor="end" font-family="system-ui">Interfaz</text>`;
  }

  // head
  svg += `<circle cx="${cx}" cy="${headY}" r="${headR}" fill="${d.light}" stroke="${d.color}" stroke-width="2.5"/>`;
  const hLines = d.headLabel.split('|');
  hLines.forEach((ln,i) => {
    svg += `<text x="${cx}" y="${headY-6+i*13}" text-anchor="middle" font-size="9" font-weight="600" fill="${d.color}" font-family="system-ui">${ln}</text>`;
  });

  // head groups
  for(let i=0;i<d.headGroups;i++){
    const angle = d.headGroups===1 ? -Math.PI/2 : -Math.PI/2+((i-(d.headGroups-1)/2)*Math.PI/(d.headGroups+1));
    const ox=cx+Math.cos(angle)*(headR+10), oy=headY+Math.sin(angle)*(headR+10);
    svg += `<circle cx="${ox}" cy="${oy}" r="5" fill="#E53935" opacity="0.7"/>`;
    svg += `<text x="${ox}" y="${oy+3.5}" text-anchor="middle" font-size="6" fill="white" font-weight="700" font-family="system-ui">${d.headGroupLabels[i]}</text>`;
  }

  svg += `<text x="${cx}" y="${headY-headR-8}" text-anchor="middle" font-size="10" fill="#546E7A" font-family="system-ui">Cabeza polar (hidrófila)</text>`;

  // tails
  tails.forEach((t,i) => {
    let pts=[];
    const seg=8, amp=6;
    for(let s=0;s<=seg;s++){
      const py=t.y+(tailLen/seg)*s;
      const px=t.x+Math.sin((s/seg)*Math.PI*3+i*Math.PI)*amp;
      pts.push(`${px},${py}`);
    }
    svg += `<polyline points="${pts.join(' ')}" fill="none" stroke="${d.accent}" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>`;
    const endX=t.x+Math.sin(Math.PI*3+i*Math.PI)*amp;
    svg += `<circle cx="${endX}" cy="${t.y+tailLen}" r="4" fill="${d.accent}"/>`;
  });

  svg += `<text x="${cx}" y="${headY+headR+tailLen+20}" text-anchor="middle" font-size="10" fill="#546E7A" font-family="system-ui">${d.tails===1?'Cola hidrofóbica':'Colas hidrofóbicas'} (lipófila${d.tails>1?'s':''})</text>`;
  svg += `</svg>`;
  return svg;
}

function hlbSVG(){
  const w=600, h=180, ml=40, mr=40, mt=40;
  const scaleW=w-ml-mr, scaleY=mt+30, barH=24;
  const toX=v=>ml+(v/20)*scaleW;
  let svg=`<svg viewBox="0 0 ${w} ${h}" width="100%" style="max-width:600px" xmlns="http://www.w3.org/2000/svg">`;
  svg+=`<text x="${w/2}" y="20" text-anchor="middle" font-size="14" font-weight="700" fill="#37474F" font-family="system-ui">Escala HLB (Balance Hidrófilo-Lipófilo)</text>`;

  HLB_ZONES.forEach(z=>{
    svg+=`<rect x="${toX(z.min)}" y="${scaleY}" width="${toX(z.max)-toX(z.min)}" height="${barH}" fill="${z.bg}" stroke="#CFD8DC" stroke-width="0.5"/>`;
    svg+=`<text x="${(toX(z.min)+toX(z.max))/2}" y="${scaleY+barH+14}" text-anchor="middle" font-size="8.5" fill="#546E7A" font-family="system-ui">${z.label}</text>`;
  });

  for(let i=0;i<=20;i++){
    svg+=`<line x1="${toX(i)}" y1="${scaleY-4}" x2="${toX(i)}" y2="${scaleY}" stroke="#90A4AE" stroke-width="1"/>`;
    if(i%2===0) svg+=`<text x="${toX(i)}" y="${scaleY-8}" text-anchor="middle" font-size="9" fill="#78909C" font-family="system-ui">${i}</text>`;
  }

  KEYS.forEach((k,idx)=>{
    const e=EM[k], x=toX(e.hlbNum), my=scaleY+barH+32+idx*24;
    svg+=`<line x1="${x}" y1="${scaleY+barH}" x2="${x}" y2="${my-8}" stroke="${e.color}" stroke-width="1.5" stroke-dasharray="3,2"/>`;
    svg+=`<circle cx="${x}" cy="${my-8}" r="4" fill="${e.color}"/>`;
    svg+=`<text x="${x+8}" y="${my-4}" font-size="11" font-weight="600" fill="${e.color}" font-family="system-ui">${e.name} (HLB ≈ ${e.hlb})</text>`;
  });

  svg+=`</svg>`;
  return svg;
}

// ─── RENDER ───
function render(){
  const d=cur();
  let html=`
  <div class="header"><h1>Emulsionantes en Alimentos</h1><p>UA: Tecnología de Emulsiones · Dr. Juan Gabriel Báez González</p><p style="margin-top:4px;font-size:12px;color:#90A4AE">Facultad de Ciencias Biológicas · UANL</p></div>
  <div class="tabs">${TABS.map(t=>`<button class="tab${state.tab===t.id?' active':''}" onclick="setTab('${t.id}')">${t.label}</button>`).join('')}</div>`;

  // selector
  if(state.tab==='structure'||state.tab==='interface'){
    html+=`<div class="selector">${KEYS.map(k=>{const e=EM[k];return `<button class="sel-btn${state.sel===k?' on':''}" style="border-color:${e.color};${state.sel===k?'background:'+e.color+';color:#fff':'color:'+e.color}" onclick="setSel('${k}')">${e.name}</button>`;}).join('')}</div>`;
  }

  html+=`<div class="content">`;

  if(state.tab==='structure'){
    html+=`<div class="split">
      <div class="split-vis">${moleculeSVG(d,false)}</div>
      <div class="split-info">
        <h2 style="color:${d.color}">${d.name}</h2>
        <div class="sub">${d.shortName} · PM ${d.mw} Da · HLB ≈ ${d.hlb}</div>
        <div class="desc">${d.description}</div>
        <h3>Aplicaciones principales:</h3>
        <ul class="app-list">${d.applications.map(a=>`<li><span class="dot" style="background:${d.accent}"></span>${a}</li>`).join('')}</ul>
      </div>
    </div>`;
  }

  if(state.tab==='interface'){
    html+=`<p class="intro">Los emulsionantes se orientan en la interfaz aceite-agua con la <strong>cabeza polar hacia la fase acuosa</strong> y las <strong>colas hidrofóbicas hacia la fase oleosa</strong>. Observa cómo la geometría molecular (número de colas, tamaño de la cabeza) determina la curvatura espontánea de la interfaz.</p>`;
    html+=`<div style="display:flex;justify-content:center">${moleculeSVG(d,true)}</div>`;
    html+=`<div class="note-box" style="border-color:${d.color};background:${d.light}"><strong>${d.name}:</strong> ${d.interfaceNote}</div>`;
  }

  if(state.tab==='hlb'){
    html+=`<p class="intro">El <strong>HLB (Hydrophilic-Lipophilic Balance)</strong> es un valor numérico que indica la afinidad relativa del emulsionante por la fase acuosa u oleosa. Valores bajos = lipofílico (W/O); valores altos = hidrofílico (O/W).</p>`;
    html+=`<div style="display:flex;justify-content:center">${hlbSVG()}</div>`;
    html+=`<div class="info-box"><strong>Nota:</strong> El HLB de la lecitina varía según su fuente (soya ≈ 7–9, huevo ≈ 9–11) y grado de purificación. Los monoglicéridos comerciales (tipo GMS, monoestearato de glicerilo) tienen HLB ≈ 3.8. Los diglicéridos raramente se usan solos como emulsionantes primarios.</div>`;
  }

  if(state.tab==='compare'){
    html+=`<p class="intro">Selecciona un emulsionante para resaltarlo. Compara la relación entre el número de colas, el HLB y el tipo de emulsión que estabiliza.</p>`;
    html+=`<div class="selector">${KEYS.map(k=>{const e=EM[k];return `<button class="sel-btn${state.sel===k?' on':''}" style="border-color:${e.color};${state.sel===k?'background:'+e.color+';color:#fff':'color:'+e.color}" onclick="setSel('${state.sel===k?'':'${k}'}')">${e.name}</button>`;}).join('')}</div>`;

    const rows=[['Abreviatura',e=>e.shortName],['HLB',e=>e.hlb],['PM aprox.',e=>e.mw+' Da'],['Colas lipofílicas',e=>e.tails],['Tipo de emulsión',e=>e.emulsionType]];
    html+=`<table><thead><tr><th style="width:25%">Propiedad</th>${KEYS.map(k=>{const e=EM[k];return `<th style="color:${state.sel===k?e.color:'#546E7A'};background:${state.sel===k?e.light:'transparent'}">${e.name}</th>`;}).join('')}</tr></thead><tbody>`;
    rows.forEach(([label,fn])=>{
      html+=`<tr><td style="font-weight:600;color:#37474F;text-align:left">${label}</td>${KEYS.map(k=>{const e=EM[k];return `<td style="background:${state.sel===k?e.light:'transparent'}">${fn(e)}</td>`;}).join('')}</tr>`;
    });
    html+=`</tbody></table>`;

    html+=`<div class="compare-row">${KEYS.map(k=>{const e=EM[k];return `<div class="compare-card${state.sel===k?' on':''}" style="border-color:${e.light};background:${state.sel===k?e.light:'#fff'}">${moleculeSVG(e,false)}<p style="color:${e.color}">${e.name}</p></div>`;}).join('')}</div>`;
  }

  if(state.tab==='quiz'){
    html+=`<p class="quiz-intro">Evalúa tu comprensión sobre emulsionantes, estructura molecular, escala HLB y aplicaciones. Recibes retroalimentación inmediata después de cada respuesta.</p>`;
    html+=`<div id="quizContainer"></div>`;
    html+=`<div id="scoreBar" style="display:none"></div>`;
    html+=`<div style="text-align:center"><button class="quiz-reset" onclick="renderQuiz()">Reiniciar cuestionario</button></div>`;
  }

  html+=`</div>`;
  html+=`<div class="footer">UA: Tecnología de Emulsiones · Dr. Juan Gabriel Báez González · Lic. en Ciencia de Alimentos · FCB-UANL</div>`;

  document.getElementById('app').innerHTML=html;
  if(state.tab==='quiz') renderQuiz();
}

function setTab(t){ state.tab=t; render(); }
function setSel(s){ state.sel=s||'monoglyceride'; render(); }

// ─── QUIZ (formato estándar de la serie: quizData + renderQuiz + ansQ) ───
const quizData = [
  {
    q:"El HLB (Hydrophilic-Lipophilic Balance) de un emulsionante indica:",
    opts:[
      "Su afinidad relativa por la fase acuosa frente a la fase oleosa",
      "La cantidad de agua que puede solubilizar por gramo de emulsionante",
      "El punto de fusión de la cadena hidrofóbica",
      "La concentración micelar crítica del emulsionante en solución"
    ],
    correct:0,
    fb:"El HLB expresa el balance entre las porciones hidrofílica y lipofílica de la molécula. Valores bajos indican afinidad por la fase oleosa (favorece emulsiones W/O); valores altos, afinidad por la fase acuosa (favorece emulsiones O/W). No mide capacidad de solubilización, temperatura de fusión ni CMC."
  },
  {
    q:"Un emulsionante con HLB ≈ 4 se utiliza principalmente para estabilizar:",
    opts:[
      "Espumas aireadas de baja densidad",
      "Emulsiones agua-en-aceite (W/O), como margarinas y spreads",
      "Emulsiones aceite-en-agua (O/W), como leche y mayonesa",
      "Sistemas de solubilización acuosa de compuestos lipofílicos"
    ],
    correct:1,
    fb:"El rango HLB 3–6 corresponde a emulsionantes lipofílicos que estabilizan emulsiones W/O (agua dispersa en aceite). Ejemplos típicos: monoglicéridos (HLB ≈ 3.8) usados en margarinas y shortenings. Emulsiones O/W requieren HLB 8–16; solubilizantes, HLB ≥ 16."
  },
  {
    q:"¿Cuál es la principal diferencia estructural entre un monoglicérido (MAG) y un diglicérido (DAG)?",
    opts:[
      "El MAG posee un grupo fosfato adicional en su cabeza polar",
      "El DAG tiene dos ácidos grasos esterificados al glicerol; el MAG solo uno",
      "El MAG contiene colina en su cabeza polar; el DAG no",
      "El DAG es más hidrofílico debido a su mayor peso molecular"
    ],
    correct:1,
    fb:"El MAG posee un ácido graso esterificado al glicerol y dos grupos hidroxilo libres (cabeza polar grande). El DAG tiene dos ácidos grasos esterificados y solo un −OH libre (cabeza polar pequeña). Ninguno de los dos contiene fosfato ni colina; esos grupos son característicos de la lecitina (fosfolípido)."
  },
  {
    q:"El diglicérido, con dos colas hidrofóbicas y una cabeza polar pequeña (un solo −OH libre), adopta forma de cono truncado invertido. Esta geometría favorece:",
    opts:[
      "Emulsiones O/W estables gracias a su alto HLB",
      "La formación de espumas aireadas por su cabeza polar reducida",
      "Curvatura negativa de la interfaz, característica de emulsiones W/O",
      "La solubilización en agua sin formar interfaz definida"
    ],
    correct:2,
    fb:"La forma molecular impone una curvatura espontánea sobre la interfaz. Cabeza pequeña y dos colas voluminosas ⇒ curvatura negativa (la fase acuosa queda dispersa en la oleosa), típica de emulsiones W/O. El DAG tiene HLB ≈ 1.8, muy lipofílico, coherente con esta geometría."
  },
  {
    q:"La lecitina se utiliza de manera característica en la fabricación de chocolate porque:",
    opts:[
      "Aporta color y aroma a la manteca de cacao",
      "Precipita las proteínas residuales del cacao",
      "Reduce la viscosidad y mejora la fluidez del sistema graso",
      "Aumenta el punto de fusión de la manteca de cacao para dar cuerpo"
    ],
    correct:2,
    fb:"En chocolate, la lecitina (~0.3–0.5%) se adsorbe sobre las partículas de azúcar y cacao, reduciendo la viscosidad plástica del sistema y mejorando la fluidez durante el moldeo. Esto disminuye la cantidad de manteca de cacao requerida sin comprometer las propiedades sensoriales."
  },
  {
    q:"La lecitina puede estabilizar tanto emulsiones O/W como W/O porque:",
    opts:[
      "Su HLB es superior a 16, lo que la hace altamente hidrofílica",
      "Posee una sola cola hidrofóbica, como el monoglicérido",
      "Su cabeza polar es aniónica con carga negativa neta",
      "Su cabeza zwitteriónica y forma cilíndrica le permiten empacar eficientemente en la interfaz en ambas curvaturas"
    ],
    correct:3,
    fb:"La lecitina (fosfatidilcolina) tiene HLB intermedio (7–9), dos colas acilo y una cabeza polar zwitteriónica (fosfato negativo + amonio cuaternario positivo). Su geometría cilíndrica no impone una curvatura preferente marcada, por lo que puede estabilizar ambos tipos de emulsión según las condiciones del sistema."
  }
];

let qAnswered=0, qCorrect=0, shuffledQuiz=[];
function renderQuiz(){
  const c=document.getElementById('quizContainer'); c.innerHTML='';
  qAnswered=0; qCorrect=0; document.getElementById('scoreBar').style.display='none';
  /* Barajar opciones de cada pregunta en cada render, preservando la respuesta correcta */
  shuffledQuiz = quizData.map(q => {
    const correctText = q.opts[q.correct];
    const opts = q.opts.slice();
    for(let i=opts.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[opts[i],opts[j]]=[opts[j],opts[i]];}
    return { q:q.q, opts:opts, correct:opts.indexOf(correctText), fb:q.fb };
  });
  /* Barajar orden de preguntas */
  for(let i=shuffledQuiz.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[shuffledQuiz[i],shuffledQuiz[j]]=[shuffledQuiz[j],shuffledQuiz[i]];}
  shuffledQuiz.forEach((q,qi)=>{
    const d=document.createElement('div'); d.className='quiz-question'; d.id='qq-'+qi;
    let oh=''; q.opts.forEach((o,oi)=>{ oh+=`<button class="quiz-opt" onclick="ansQ(${qi},${oi})">${o}</button>`; });
    const qText = (qi+1)+'. '+q.q.replace(/^\s*\d+\.\s*/,'');
    d.innerHTML=`<p class="q-text">${qText}</p><div class="quiz-options">${oh}</div><div class="quiz-feedback" id="qf-${qi}"></div>`;
    c.appendChild(d);
  });
}
function ansQ(qi,oi){
  const q=shuffledQuiz[qi], d=document.getElementById('qq-'+qi);
  if(d.dataset.done) return;
  d.dataset.done='1';
  const btns=d.querySelectorAll('.quiz-opt');
  btns.forEach(b=>b.classList.add('disabled'));
  const ok=(oi===q.correct);
  if(ok) qCorrect++;
  btns[oi].classList.add(ok?'correct':'incorrect');
  if(!ok) btns[q.correct].classList.add('correct');
  const fb=document.getElementById('qf-'+qi);
  fb.className='quiz-feedback show '+(ok?'ok':'bad');
  fb.innerHTML=(ok?'<strong>Correcto.</strong> ':'<strong>Incorrecto.</strong> ')+q.fb;
  qAnswered++;
  if(qAnswered===quizData.length){
    const sb=document.getElementById('scoreBar');
    sb.style.display='block';
    const pct=Math.round(qCorrect/quizData.length*100);
    sb.innerHTML=`Puntaje: <strong>${qCorrect} / ${quizData.length}</strong> (${pct}%)`;
  }
}

render();
</script>
</body>
</html>
