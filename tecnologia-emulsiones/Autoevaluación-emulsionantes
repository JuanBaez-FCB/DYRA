// ============================================================
// ESTADO DE LA APLICACIÓN
// ============================================================
let studentName = '';
let studentMatricula = '';
let quizQuestions = [];
let currentIndex = 0;
let userAnswers = [];
let score = 0;
let startTime = null;
let answeredCurrent = false;

// ============================================================
// UTILIDADES
// ============================================================
function shuffleArray(arr) {
  const a = arr.slice();
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

function pickRandomQuestions(bank, n) {
  const shuffled = shuffleArray(bank);
  return shuffled.slice(0, n);
}

function prepareQuizQuestions() {
  const selected = pickRandomQuestions(QUESTION_BANK, 10);
  return selected.map(q => {
    const optionIndices = [0, 1, 2, 3];
    const shuffledIndices = shuffleArray(optionIndices);
    const shuffledOptions = shuffledIndices.map(i => q.options[i]);
    const newCorrectIndex = shuffledIndices.indexOf(q.correct);
    return {
      id: q.id,
      question: q.question,
      options: shuffledOptions,
      correctIndex: newCorrectIndex,
      justification: q.justification
    };
  });
}

function formatTime(ms) {
  const totalSeconds = Math.floor(ms / 1000);
  const minutes = Math.floor(totalSeconds / 60);
  const seconds = totalSeconds % 60;
  return minutes + ':' + seconds.toString().padStart(2, '0');
}

function escapeHtml(str) {
  const div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
}

// ============================================================
// PANTALLA 1: LOGIN
// ============================================================
const loginForm = document.getElementById('login-form');
const loginError = document.getElementById('login-error');

loginForm.addEventListener('submit', function(e) {
  e.preventDefault();
  const nameVal = document.getElementById('input-name').value.trim();
  const matriculaVal = document.getElementById('input-matricula').value.trim();

  if (!nameVal || !matriculaVal) {
    loginError.classList.remove('hidden');
    return;
  }
  loginError.classList.add('hidden');
  studentName = nameVal;
  studentMatricula = matriculaVal;
  startQuiz();
});

// ============================================================
// INICIO / REINICIO DEL QUIZ
// ============================================================
function startQuiz() {
  quizQuestions = prepareQuizQuestions();
  currentIndex = 0;
  userAnswers = [];
  score = 0;
  startTime = Date.now();
  answeredCurrent = false;

  document.getElementById('screen-login').classList.add('hidden');
  document.getElementById('screen-results').classList.add('hidden');
  document.getElementById('screen-quiz').classList.remove('hidden');

  renderQuestion();
}

document.getElementById('btn-restart').addEventListener('click', function() {
  document.getElementById('screen-results').classList.add('hidden');
  startQuiz();
});

// ============================================================
// RENDER DE PREGUNTA
// ============================================================
function renderQuestion() {
  answeredCurrent = false;
  const q = quizQuestions[currentIndex];
  const total = quizQuestions.length;

  document.getElementById('quiz-progress-label').textContent = 'Pregunta ' + (currentIndex + 1) + '/' + total;
  document.getElementById('quiz-score-label').textContent = 'Aciertos: ' + score;
  document.getElementById('progress-bar').style.width = (((currentIndex + 1) / total) * 100) + '%';

  document.getElementById('question-text').textContent = q.question;

  const optionsContainer = document.getElementById('options-container');
  optionsContainer.innerHTML = '';

  q.options.forEach((optText, idx) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'option-btn';
    btn.textContent = String.fromCharCode(65 + idx) + ') ' + optText;
    btn.dataset.index = idx;
    btn.addEventListener('click', function() {
      handleAnswer(idx);
    });
    optionsContainer.appendChild(btn);
  });

  const fb = document.getElementById('feedback-box');
  fb.classList.add('hidden');
  fb.innerHTML = '';
  fb.className = 'feedback-box hidden';
  document.getElementById('btn-next').classList.add('hidden');
}

// ============================================================
// MANEJO DE RESPUESTA
// ============================================================
function handleAnswer(selectedIdx) {
  if (answeredCurrent) return;
  answeredCurrent = true;

  const q = quizQuestions[currentIndex];
  const isCorrect = selectedIdx === q.correctIndex;
  if (isCorrect) score++;

  const optionButtons = document.querySelectorAll('#options-container .option-btn');
  optionButtons.forEach((btn, idx) => {
    btn.disabled = true;
    if (idx === q.correctIndex) {
      btn.classList.add('option-correct');
    } else if (idx === selectedIdx && !isCorrect) {
      btn.classList.add('option-incorrect');
    } else {
      btn.classList.add('option-disabled-other');
    }
  });

  const feedbackBox = document.getElementById('feedback-box');
  feedbackBox.classList.remove('hidden');
  if (isCorrect) {
    feedbackBox.className = 'feedback-box correct fade-in';
    feedbackBox.innerHTML = '<strong>✓ ¡Correcto!</strong><br>' + escapeHtml(q.justification);
  } else {
    feedbackBox.className = 'feedback-box incorrect fade-in';
    feedbackBox.innerHTML = '<strong>✗ No es correcto.</strong> La respuesta correcta es: <em>"' + escapeHtml(q.options[q.correctIndex]) + '"</em><br>' + escapeHtml(q.justification);
  }

  document.getElementById('quiz-score-label').textContent = 'Aciertos: ' + score;

  userAnswers.push({
    questionId: q.id,
    question: q.question,
    selectedText: q.options[selectedIdx],
    isCorrect: isCorrect,
    correctText: q.options[q.correctIndex],
    justification: q.justification
  });

  const nextBtn = document.getElementById('btn-next');
  nextBtn.classList.remove('hidden');
  nextBtn.textContent = (currentIndex === quizQuestions.length - 1) ? 'Ver resultados →' : 'Siguiente pregunta →';
}

document.getElementById('btn-next').addEventListener('click', function() {
  if (currentIndex < quizQuestions.length - 1) {
    currentIndex++;
    renderQuestion();
  } else {
    showResults();
  }
});

// ============================================================
// PANTALLA 3: RESULTADOS
// ============================================================
function getAttemptCount(matricula) {
  const key = 'emulsiones_quiz_attempts_' + matricula;
  let count = parseInt(localStorage.getItem(key) || '0', 10);
  count += 1;
  localStorage.setItem(key, String(count));
  return count;
}

function showResults() {
  const elapsedMs = Date.now() - startTime;
  const total = quizQuestions.length;
  const percent = Math.round((score / total) * 100);
  const attemptNumber = getAttemptCount(studentMatricula);

  document.getElementById('screen-quiz').classList.add('hidden');
  document.getElementById('screen-results').classList.remove('hidden');

  document.getElementById('results-student').textContent = studentName + ' · Matrícula: ' + studentMatricula;
  document.getElementById('results-score').textContent = score + '/' + total;
  document.getElementById('results-percent').textContent = percent + '%';
  document.getElementById('results-time').textContent = formatTime(elapsedMs);
  document.getElementById('results-attempt').textContent = '#' + attemptNumber;

  const tbody = document.getElementById('results-body');
  tbody.innerHTML = '';
  userAnswers.forEach((ans, idx) => {
    const tr = document.createElement('tr');
    if (!ans.isCorrect) tr.className = 'row-wrong';
    tr.innerHTML =
      '<td>' + (idx + 1) + '</td>' +
      '<td>' + escapeHtml(ans.question) + '</td>' +
      '<td class="' + (ans.isCorrect ? 'ans-correct-text' : 'ans-wrong-text') + '">' + escapeHtml(ans.selectedText) + ' ' + (ans.isCorrect ? '✓' : '✗') + '</td>' +
      '<td class="ans-correct-text">' + escapeHtml(ans.correctText) + '</td>' +
      '<td class="justif-text">' + escapeHtml(ans.justification) + '</td>';
    tbody.appendChild(tr);
  });
}
</script>
</body>
</html>
