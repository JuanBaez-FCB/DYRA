<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Simulador: IR, °Brix y Mastersizer 3000 — Tecnología de Emulsiones</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/katex.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/katex.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/contrib/auto-render.min.js"></script>
<style>
:root{
  --navy:#1E3A5F; --gold:#C9A227; --cream:#F7F6F2;
  --ink:#2b2b2b; --ok:#2e7d32; --bad:#b23b3b; --card:#ffffff;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Cambria, Georgia, serif; background:var(--cream); color:var(--ink); line-height:1.5;}
header{background:var(--navy); color:#fff; padding:18px 24px; border-bottom:5px solid var(--gold);}
header h1{font-size:1.35rem; font-weight:700;}
header .sub{font-family:Calibri, Arial, sans-serif; font-size:.95rem; color:#dfe6ef; margin-top:4px;}
.container{max-width:1180px; margin:0 auto; padding:20px;}
.warn{background:#fff8e6; border:1.5px solid var(--gold); border-left:6px solid var(--gold);
  padding:12px 16px; border-radius:8px; font-family:Calibri, Arial, sans-serif; font-size:.95rem; margin-bottom:20px;}
.grid{display:grid; grid-template-columns:360px 1fr; gap:20px;}
@media(max-width:900px){.grid{grid-template-columns:1fr;}}
.card{background:var(--card); border-radius:12px; padding:18px 20px; box-shadow:0 2px 8px rgba(30,58,95,.10); margin-bottom:20px;}
.card h2{font-size:1.05rem; color:var(--navy); border-bottom:2px solid var(--gold); padding-bottom:6px; margin-bottom:14px;}
label{display:block; font-family:Calibri, Arial, sans-serif; font-weight:600; font-size:.95rem; color:var(--navy); margin:14px 0 4px;}
select,input[type=text],input[type=number]{width:100%; padding:10px; font-size:1rem; font-family:Calibri, Arial, sans-serif;
  border:1.5px solid #c6cfda; border-radius:8px; background:#fff;}
input[type=range]{width:100%; height:34px; accent-color:var(--navy); touch-action:manipulation;}
.bigval{font-size:1.5rem; color:var(--navy); font-weight:700;}
.readout{font-family:Calibri, Arial, sans-serif; font-size:.95rem; background:var(--cream);
  border-radius:8px; padding:10px 12px; margin-top:8px;}
.readout b{color:var(--navy);}
.flag{color:var(--bad); font-weight:700;}
.okflag{color:var(--ok); font-weight:700;}
button{font-family:Calibri, Arial, sans-serif; font-size:.95rem; font-weight:600; cursor:pointer;
  border:none; border-radius:8px; padding:11px 16px; min-height:44px;}
.btn-navy{background:var(--navy); color:#fff;}
.btn-gold{background:var(--gold); color:var(--navy);}
.btn-ghost{background:#eef1f5; color:var(--navy); border:1.5px solid #c6cfda;}
button:active{transform:scale(.98);}
.btnrow{display:flex; gap:10px; flex-wrap:wrap; margin-top:12px;}
details{margin-top:14px; font-family:Calibri, Arial, sans-serif; font-size:.95rem;}
details summary{cursor:pointer; font-weight:700; color:var(--navy); padding:8px 0;}
.stats{width:100%; border-collapse:collapse; font-family:Calibri, Arial, sans-serif; font-size:.92rem; margin-top:12px;}
.stats th,.stats td{border:1px solid #d7dde5; padding:7px 9px; text-align:center;}
.stats th{background:var(--navy); color:#fff; font-weight:600;}
.stats tr:nth-child(even){background:#f2f4f8;}
.err-hi{color:var(--bad); font-weight:700;}
.err-lo{color:var(--ok); font-weight:700;}
.chartbox{position:relative; height:380px;}
@media(max-width:600px){.chartbox{height:300px;}}
.quiz-q{border:1.5px solid #d7dde5; border-radius:10px; padding:14px; margin-bottom:14px; font-family:Calibri, Arial, sans-serif;}
.quiz-q p.q{font-weight:700; color:var(--navy); margin-bottom:8px;}
.quiz-q label{display:flex; align-items:flex-start; gap:8px; font-weight:400; margin:6px 0; cursor:pointer; min-height:34px;}
.quiz-q input[type=radio]{width:20px; height:20px; margin-top:2px; accent-color:var(--navy);}
.fb{margin-top:8px; padding:8px 10px; border-radius:8px; font-size:.92rem; display:none;}
.fb.ok{background:#e8f3e9; color:var(--ok); display:block;}
.fb.bad{background:#f9e9e9; color:var(--bad); display:block;}
footer{background:var(--navy); color:#cfd8e3; font-family:Calibri, Arial, sans-serif;
  font-size:.85rem; text-align:center; padding:14px; margin-top:30px;}
.katexblock{background:var(--cream); border-radius:8px; padding:12px; margin:10px 0; overflow-x:auto;}
.idrow{display:grid; grid-template-columns:1fr 1fr; gap:10px;}
@media(max-width:600px){.idrow{grid-template-columns:1fr;}}
</style>
</head>
<body>

<header>
  <h1>Simulador ilustrativo: Índice de refracción, °Brix y parámetros ópticos en difracción láser</h1>
  <div class="sub">Tecnología de Emulsiones · 7.º semestre · Facultad de Ciencias Biológicas, UANL · Suite DYRA</div>
</header>

<div class="container">

<div class="warn">
⚠️ <b>Simulador didáctico.</b> No reproduce el algoritmo propietario del Mastersizer&nbsp;3000 (Malvern Panalytical).
Los desplazamientos de la curva son <b>ilustrativos del sentido físico del error</b> al ingresar parámetros ópticos incorrectos;
no son predicciones cuantitativas de teoría de Mie. Valores de IR marcados [verificar] deben confirmarse contra literatura antes de uso formal.
</div>

<div class="grid">

  <!-- ===== PANEL DE ENTRADA ===== -->
  <div>
    <div class="card">
      <h2>1 · Formulación de la bebida</h2>

      <label for="brix">Sólidos solubles del jarabe (°Brix): <span class="bigval" id="brixVal">12</span> °Bx</label>
      <input type="range" id="brix" min="0" max="60" step="1" value="12">

      <label for="fase">Fase dispersa (aceite)</label>
      <select id="fase">
        <option value="1.4727" data-name="Aceite esencial de naranja (d-limoneno)">Aceite esencial de naranja — IR ≈ 1.4727 [verificar]</option>
        <option value="1.4736" data-name="Aceite de soya">Aceite de soya — IR ≈ 1.4736 [verificar]</option>
        <option value="1.4490" data-name="Triglicéridos de cadena media (TCM)">TCM — IR ≈ 1.449 [verificar]</option>
      </select>

      <label for="emul">Emulsionante (define el tamaño de gota base)</label>
      <select id="emul">
        <option value="1.0,1.8" data-name="Goma arábiga">Goma arábiga — d₅₀ ≈ 1.0 µm [ilustrativo]</option>
        <option value="0.5,1.6" data-name="Almidón OSA">Almidón OSA — d₅₀ ≈ 0.5 µm [ilustrativo]</option>
        <option value="0.3,1.5" data-name="Éster de sacarosa">Éster de sacarosa — d₅₀ ≈ 0.3 µm [ilustrativo]</option>
      </select>
    </div>

    <div class="card">
      <h2>2 · Parámetros ingresados al software</h2>
      <label for="nIng">IR del dispersante que el analista escribe en el método</label>
      <input type="number" id="nIng" min="1.30" max="1.55" step="0.0001" value="1.3330">
      <div class="btnrow">
        <button class="btn-ghost" id="btnAgua">Usar 1.3330 (agua pura)</button>
        <button class="btn-gold" id="btnReal">Usar el IR real del jarabe</button>
      </div>

      <div class="readout" id="irReadout"></div>
    </div>

    <div class="card">
      <h2>3 · Datos del estudiante</h2>
      <div class="idrow">
        <div><label for="alumno">Nombre</label><input type="text" id="alumno" placeholder="Nombre completo"></div>
        <div><label for="matricula">Matrícula</label><input type="text" id="matricula" placeholder="Matrícula UANL"></div>
      </div>
    </div>
  </div>

  <!-- ===== RESULTADOS ===== -->
  <div>
    <div class="card">
      <h2>Distribución de tamaños de partícula (volumen)</h2>
      <div class="chartbox"><canvas id="dist"></canvas></div>

      <table class="stats">
        <thead><tr><th>Parámetro</th><th>Curva "verdadera"</th><th>Reportada por el software</th><th>% error</th></tr></thead>
        <tbody id="statsBody"></tbody>
      </table>

      <div class="btnrow">
        <button class="btn-navy" id="btnPorque">¿Por qué cambió la curva?</button>
        <button class="btn-ghost" id="btnComo">¿Cómo se calcula esta simulación?</button>
      </div>

      <details id="dPorque">
        <summary>Explicación física</summary>
        <div>
          <p>El Mastersizer&nbsp;3000 no "ve" gotas: mide un <b>patrón angular de luz dispersada</b> y lo invierte
          matemáticamente con la <b>teoría de Mie</b>, que necesita el contraste óptico entre la gota y el medio:</p>
          <div class="katexblock">$$m=\frac{n_{\text{fase dispersa}}}{n_{\text{dispersante}}}, \qquad \Delta n = \left|n_{d}-n_{c}\right|$$</div>
          <p>Los °Brix elevan el IR de la fase continua (agua 1.3330 → jarabe 40&nbsp;°Bx ≈ 1.3999).
          Si el analista deja 1.3330, el software asume un contraste <b>mayor</b> del real:
          interpreta que la luz se desvió "demasiado poco" para ese contraste y atribuye la señal a gotas de otro tamaño.
          Resultado: D[4,3], D[3,2], d₁₀, d₅₀ y d₉₀ incorrectos, con el error creciendo para gotas &lt;10&nbsp;µm,
          donde la aproximación de Fraunhofer (que ignora el IR) también deja de ser válida.</p>
        </div>
      </details>

      <details id="dComo">
        <summary>Regla heurística del simulador (transparencia)</summary>
        <div>
          <p>La curva "verdadera" es una log-normal en volumen con d₅₀ y σ<sub>g</sub> fijados por el emulsionante.
          La curva "reportada" se genera con una regla explícita, <b>no</b> con la inversión de Mie:</p>
          <div class="katexblock">$$d_{50}^{\text{rep}} = d_{50}^{\text{real}}\cdot\frac{\Delta n_{\text{real}}}{\Delta n_{\text{ingresado}}}
          \qquad ; \qquad \sigma_g^{\text{rep}}=\sigma_g\left(1+0.15\,\frac{|\Delta n_{\text{ing}}-\Delta n_{\text{real}}|}{\Delta n_{\text{real}}}\right)$$</div>
          <p>El <b>sentido</b> del desplazamiento es físicamente correcto (subestimar el IR del dispersante infla el contraste
          supuesto y reduce el tamaño aparente), pero la <b>magnitud</b> es ilustrativa. El equipo real resuelve la inversión
          completa de Mie, cuyo error no siempre es monótono. Los estadísticos sí se calculan con fórmulas analíticas exactas
          de la distribución log-normal (Hatch–Choate):</p>
          <div class="katexblock">$$D[4{,}3]=d_{50}\,e^{+\tfrac{1}{2}\ln^2\sigma_g}\qquad
          D[3{,}2]=d_{50}\,e^{-\tfrac{1}{2}\ln^2\sigma_g}\qquad
          d_{10,90}=d_{50}\,e^{\mp 1.2816\,\ln\sigma_g}$$</div>
          <p>Correlación °Brix→IR: interpolación lineal de la tabla ICUMSA para soluciones de sacarosa a 20&nbsp;°C
          [verificar contra tabla oficial ICUMSA/CRC antes de uso formal].</p>
        </div>
      </details>
    </div>

    <!-- ===== QUIZ ===== -->
    <div class="card">
      <h2>Evaluación formativa</h2>
      <div id="quiz"></div>
      <div class="btnrow">
        <button class="btn-navy" id="btnCal">Calificar</button>
        <button class="btn-gold" id="btnCSV">Exportar resultados (CSV/Excel)</button>
      </div>
      <div class="readout" id="score" style="display:none"></div>
    </div>
  </div>
</div>
</div>

<footer>
Dr. Juan G. Báez González · Departamento de Alimentos, FCB-UANL · Recurso educativo abierto — uso didáctico.<br>
Mastersizer 3000® es marca de Malvern Panalytical; este simulador no está afiliado al fabricante.
</footer>

<script>
/* ===== Tabla ICUMSA sacarosa 20 °C (IR vs %p/p) [verificar] ===== */
const BRIX_IR = [
 [0,1.3330],[5,1.3403],[10,1.3478],[15,1.3557],[20,1.3639],[25,1.3723],
 [30,1.3812],[35,1.3903],[40,1.3999],[45,1.4098],[50,1.4201],[55,1.4307],[60,1.4419]
];
function brixToIR(b){
  for(let i=0;i<BRIX_IR.length-1;i++){
    const [b1,n1]=BRIX_IR[i],[b2,n2]=BRIX_IR[i+1];
    if(b>=b1&&b<=b2) return n1+(n2-n1)*(b-b1)/(b2-b1);
  }
  return BRIX_IR.at(-1)[1];
}

const Z90=1.28155;
const fmt=(x,d=3)=>Number(x).toFixed(d);

/* Estadísticos log-normal (base volumen) */
function lnStats(d50,sg){
  const L=Math.log(sg);
  return {
    d10:d50*Math.exp(-Z90*L), d50:d50, d90:d50*Math.exp(Z90*L),
    D43:d50*Math.exp(0.5*L*L), D32:d50*Math.exp(-0.5*L*L)
  };
}
function lognPDF(d,d50,sg){
  const L=Math.log(sg);
  return Math.exp(-Math.pow(Math.log(d/d50),2)/(2*L*L))/(L*Math.sqrt(2*Math.PI));
}

/* Ejes: 0.01–100 µm log-espaciado */
const X=[]; for(let e=-2;e<=2.0001;e+=0.04) X.push(Math.pow(10,e));

let chart;
function update(){
  const brix=+document.getElementById('brix').value;
  document.getElementById('brixVal').textContent=brix;
  const nReal=brixToIR(brix);
  const nDisp=+document.getElementById('fase').value;
  const nIng=+document.getElementById('nIng').value||1.3330;
  const [d50,sg]=document.getElementById('emul').value.split(',').map(Number);

  const dnReal=Math.abs(nDisp-nReal);
  const dnIng=Math.max(Math.abs(nDisp-nIng),1e-4);
  const ratio=dnReal/dnIng;
  const d50r=d50*ratio;
  const sgr=Math.min(sg*(1+0.15*Math.abs(dnIng-dnReal)/Math.max(dnReal,1e-4)), sg*1.5);

  /* Readout IR */
  const delta=nIng-nReal;
  document.getElementById('irReadout').innerHTML=
    `IR real del jarabe (${brix} °Bx): <b>${fmt(nReal,4)}</b><br>`+
    `IR ingresado: <b>${fmt(nIng,4)}</b> — Δ = <span class="${Math.abs(delta)>0.002?'flag':'okflag'}">${fmt(delta,4)}</span><br>`+
    `Contraste Δn real: <b>${fmt(dnReal,4)}</b> · Δn asumido por el software: <b>${fmt(dnIng,4)}</b>`;

  /* Curvas */
  const yT=X.map(d=>lognPDF(d,d50,sg));
  const yR=X.map(d=>lognPDF(d,d50r,sgr));
  const mT=Math.max(...yT), mR=Math.max(...yR);
  const dT=X.map((d,i)=>({x:d,y:100*yT[i]/mT}));
  const dR=X.map((d,i)=>({x:d,y:100*yR[i]/mR}));

  if(!chart){
    chart=new Chart(document.getElementById('dist'),{
      type:'line',
      data:{datasets:[
        {label:'Verdadera (IR correcto)',data:dT,borderColor:'#1E3A5F',backgroundColor:'rgba(30,58,95,.10)',fill:true,pointRadius:0,borderWidth:2.5,tension:.3},
        {label:'Reportada (IR ingresado)',data:dR,borderColor:'#C9A227',backgroundColor:'rgba(201,162,39,.12)',fill:true,pointRadius:0,borderWidth:2.5,borderDash:[7,4],tension:.3}
      ]},
      options:{
        responsive:true,maintainAspectRatio:false,animation:{duration:250},
        scales:{
          x:{type:'logarithmic',min:.01,max:100,title:{display:true,text:'Diámetro de partícula (µm)',font:{family:'Calibri',weight:'600'}}},
          y:{min:0,max:105,title:{display:true,text:'Densidad de volumen (normalizada, %)',font:{family:'Calibri',weight:'600'}}}
        },
        plugins:{legend:{labels:{font:{family:'Calibri',size:13}}}}
      }
    });
  }else{
    chart.data.datasets[0].data=dT;
    chart.data.datasets[1].data=dR;
    chart.update();
  }

  /* Tabla */
  const T=lnStats(d50,sg), R=lnStats(d50r,sgr);
  const rows=[['D[4,3]','D43'],['D[3,2]','D32'],['d₁₀','d10'],['d₅₀','d50'],['d₉₀','d90']];
  document.getElementById('statsBody').innerHTML=rows.map(([lab,k])=>{
    const e=100*(R[k]-T[k])/T[k];
    return `<tr><td>${lab} (µm)</td><td>${fmt(T[k])}</td><td>${fmt(R[k])}</td>
      <td class="${Math.abs(e)>5?'err-hi':'err-lo'}">${e>=0?'+':''}${fmt(e,1)} %</td></tr>`;
  }).join('');
}

/* Controles */
['brix','fase','emul','nIng'].forEach(id=>document.getElementById(id).addEventListener('input',update));
document.getElementById('btnAgua').onclick=()=>{document.getElementById('nIng').value='1.3330';update();};
document.getElementById('btnReal').onclick=()=>{
  const b=+document.getElementById('brix').value;
  document.getElementById('nIng').value=fmt(brixToIR(b),4);update();
};
document.getElementById('btnPorque').onclick=()=>{const d=document.getElementById('dPorque');d.open=!d.open;d.scrollIntoView({behavior:'smooth',block:'nearest'});};
document.getElementById('btnComo').onclick=()=>{const d=document.getElementById('dComo');d.open=!d.open;d.scrollIntoView({behavior:'smooth',block:'nearest'});};

/* ===== Quiz ===== */
const QUIZ=[
 {q:"1. Un técnico analiza una cloud emulsion diluida en jarabe de 40 °Bx pero deja 1.3330 como IR del dispersante. Respecto al valor verdadero, el d₅₀ reportado será:",
  o:["Mayor (el software sobreestima el tamaño)","Menor (el software subestima el tamaño)","Idéntico: el IR del dispersante no interviene en teoría de Mie"],a:1,
  fb:"El software asume un contraste óptico mayor del real (Δn ingresado > Δn real) y atribuye la señal a gotas más pequeñas. Compruébalo en el simulador con 40 °Bx."},
 {q:"2. ¿Por qué el refractómetro puede reportar °Brix a partir de una medición óptica?",
  o:["Porque la sacarosa absorbe luz UV proporcionalmente a su concentración","Porque el IR de la solución aumenta con la concentración de sólidos solubles (tabla ICUMSA)","Porque los °Brix se miden por densidad, no por óptica"],a:1,
  fb:"El refractómetro mide el IR y lo convierte a % p/p de sacarosa mediante la correlación ICUMSA; por eso IR y °Brix son dos lecturas de la misma propiedad."},
 {q:"3. La aproximación de Fraunhofer (que ignora los IR) es aceptable cuando:",
  o:["Las gotas son grandes (>~10 µm) y opacas, con alto contraste óptico","Las gotas son submicrónicas, como las de un éster de sacarosa","Siempre que la muestra esté diluida"],a:0,
  fb:"Fraunhofer trata la partícula como disco opaco: falla para gotas pequeñas o transparentes con bajo Δn — justo el caso de las emulsiones de bebida, donde Mie (y sus IR) es obligatorio."},
 {q:"4. Cambiar goma arábiga por éster de sacarosa en la formulación (misma energía de homogeneización) desplaza la curva verdadera hacia:",
  o:["Tamaños menores, por mayor actividad interfacial y menor tensión","Tamaños mayores, porque el éster forma multicapas gruesas","No la desplaza: el emulsionante no afecta el tamaño de gota"],a:0,
  fb:"Emulsionantes de menor peso molecular y alta actividad interfacial reducen la tensión más rápido durante la homogeneización → gotas más pequeñas (verifícalo en el selector del simulador)."}
];
document.getElementById('quiz').innerHTML=QUIZ.map((it,i)=>
 `<div class="quiz-q"><p class="q">${it.q}</p>`+
 it.o.map((o,j)=>`<label><input type="radio" name="q${i}" value="${j}"> ${o}</label>`).join('')+
 `<div class="fb" id="fb${i}"></div></div>`).join('');

let lastScore=null;
document.getElementById('btnCal').onclick=()=>{
  let ok=0;
  QUIZ.forEach((it,i)=>{
    const sel=document.querySelector(`input[name=q${i}]:checked`);
    const fb=document.getElementById('fb'+i);
    if(sel&&+sel.value===it.a){ok++;fb.className='fb ok';fb.textContent='✔ Correcto. '+it.fb;}
    else{fb.className='fb bad';fb.textContent='✘ Incorrecto. '+it.fb;}
  });
  lastScore=ok;
  const s=document.getElementById('score');
  s.style.display='block';
  s.innerHTML=`Aciertos: <b>${ok} / ${QUIZ.length}</b> (${fmt(100*ok/QUIZ.length,0)} %)`;
};
document.getElementById('btnCSV').onclick=()=>{
  if(lastScore===null){alert('Primero presiona "Calificar".');return;}
  const nom=document.getElementById('alumno').value||'(sin nombre)';
  const mat=document.getElementById('matricula').value||'(sin matrícula)';
  const brix=document.getElementById('brix').value;
  const ans=QUIZ.map((_,i)=>{const s=document.querySelector(`input[name=q${i}]:checked`);return s?+s.value+1:'-';}).join(';');
  const csv='\uFEFF'+["Nombre,Matricula,Fecha,Brix_simulado,Respuestas(1-index),Aciertos,Total",
    `"${nom}","${mat}","${new Date().toLocaleString('es-MX')}",${brix},"${ans}",${lastScore},${QUIZ.length}`].join('\n');
  const a=document.createElement('a');
  a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8;'}));
  a.download=`evaluacion_IR_Brix_${mat.replace(/\W/g,'')||'alumno'}.csv`;
  a.click();
};

update();
document.addEventListener('DOMContentLoaded',()=>renderMathInElement(document.body,{delimiters:[{left:'$$',right:'$$',display:true}]}));
renderMathInElement(document.body,{delimiters:[{left:'$$',right:'$$',display:true}]});
</script>
</body>
</html>
